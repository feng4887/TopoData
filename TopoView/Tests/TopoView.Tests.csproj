<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TopoView.csproj" />
    <PackageReference Include="Avalonia.Headless" Version="11.3.22" />
    <!-- The engine layer is a plain assembly reference, so it does not flow through the project
         reference above; the checks call ItemPool and UAClientHelperAPI from it directly. -->
    <Reference Include="hiServer"><HintPath>..\Runtime\hiServer.dll</HintPath></Reference>
  </ItemGroup>
</Project>
