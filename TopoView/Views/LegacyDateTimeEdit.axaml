<!-- Timestamp editing for the DateTimeOffsetEdit controls of TopoData/ucHisQuery.Designer.cs: a typed
     field with the dropdown calendar and clock the original editor had. -->
<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="TopoView.Views.LegacyDateTimeEdit">
  <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
    <TextBox x:Name="editor" Width="160" Watermark="yyyy-MM-dd HH:mm:ss" />
    <Button x:Name="picker" Grid.Column="1" MinWidth="34" Padding="8,7">
      <ui:SymbolIcon Symbol="Calendar" FontSize="15" />
      <Button.Flyout>
        <Flyout Placement="Bottom">
          <StackPanel Spacing="10">
            <Calendar x:Name="calendar" SelectionMode="SingleDate" />
            <TimePicker x:Name="timePicker" ClockIdentifier="24HourClock" HorizontalAlignment="Stretch" />
          </StackPanel>
        </Flyout>
      </Button.Flyout>
    </Button>
  </Grid>
</UserControl>
