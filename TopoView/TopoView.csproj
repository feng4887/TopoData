<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <Version>1.3.0</Version>
    <Authors>Topotech</Authors>
    <ApplicationIcon>Assets\2.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.4.1" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
    <PackageReference Include="FluentAvaloniaUI" Version="2.4.1" />
    <PackageReference Include="Flee" Version="2.0.0" />
    <PackageReference Include="MQTTnet" Version="5.1.0.1559" />
    <PackageReference Include="NModbus" Version="3.0.83" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Client" Version="1.5.374.158" />
    <PackageReference Include="SqlSugarCore" Version="5.1.4.169" />
    <PackageReference Include="System.IO.Ports" Version="10.0.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.1" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
    <PackageReference Include="Npgsql" Version="8.0.6" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="MySqlConnector" Version="2.3.7" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Compile Remove="Tests/**/*.cs" />
    <Compile Update="**/*.axaml.cs">
      <DependentUpon>%(Filename)</DependentUpon>
    </Compile>
    <AvaloniaResource Include="Assets/**" />
    <EmbeddedResource Include="Assets\Python-Mode.xshd" />
    <Content Include="Assets\2.ico" />
    <!-- Linux 桌面集成：ELF 无内嵌图标机制，图标靠 .desktop + hicolor 主题目录（install.sh 安装）。
         Link 平铺到发布根目录，与 TopoView 可执行文件同级。 -->
    <Content Include="linux\TopoView.desktop" Link="TopoView.desktop" CopyToPublishDirectory="PreserveNewest" Condition="'$(RuntimeIdentifier)' == 'linux-x64'" />
    <Content Include="linux\install.sh" Link="install.sh" CopyToPublishDirectory="PreserveNewest" Condition="'$(RuntimeIdentifier)' == 'linux-x64'" />
    <Content Include="Assets\topoview.png" Link="topoview.png" CopyToPublishDirectory="PreserveNewest" Condition="'$(RuntimeIdentifier)' == 'linux-x64'" />
    <None Update="README.md;VALIDATION.md;THIRD_PARTY_NOTICES.md;docs/**" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- The acquisition engines (OPC UA / Profinet S7 / Modbus) are consumed from the prebuilt
         AnyCPU hiServer.dll in Runtime/ so TopoView and the legacy service share one driver
         implementation. It must stay AnyCPU (32BITREQUIRED unset) or x64 TopoView cannot load it;
         rebuild with: dotnet build auDAServer/hiServer.csproj -c Release -p:PlatformTarget=AnyCPU
         hiLib and Log4 stay project references (like the legacy TopoData project) so matching
         build products always sit next to hiServer.dll at runtime. -->
    <Reference Include="hiServer"><HintPath>Runtime\hiServer.dll</HintPath></Reference>
    <ProjectReference Include="..\auDASLib\hiLib.csproj" />
    <ProjectReference Include="..\StdLog4\Log4.csproj" />
  </ItemGroup>
</Project>
