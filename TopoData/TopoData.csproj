      <SubType>Form</SubType>
    </Compile>
    <Compile Update="DriverPanel\diaOPCUATagSelect.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="DriverPanel\ucDriverEmpty.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="DriverPanel\ucDriverOPCDA.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="DriverPanel\ucDriverOPCUA.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="DriverPanel\ucDriverProfinet.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
